  "paths": {
    "/api/v1/cutouts/": {
      "post": {
        "operationId": "cutouts_create",
        "tags": [
          "cutouts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CutoutRequest"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/CutoutRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CutoutRequest"
              }
            }
          },
          "required": true
        },
        "security": [
          {
            "cookieAuth": []
          },
          {
            "basicAuth": []
          },
          {}
        ],
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CutoutJob"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/v1/cutouts/{cutout_id}/fits/": {
      "get": {
        "operationId": "cutouts_fits_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "cutout_id",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "tags": [
          "cutouts"
        ],
        "security": [
