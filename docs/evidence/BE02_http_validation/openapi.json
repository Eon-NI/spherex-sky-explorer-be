  "components": {
    "schemas": {
      "CutoutJob": {
        "type": "object",
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "status_url": {
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status_url"
        ]
      },
      "CutoutJobStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "result_key": {
            "type": "string",
            "nullable": true
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "result": {
            "type": "object",
            "additionalProperties": {},
            "nullable": true
          }
        },
        "required": [
          "error",
          "id",
          "result",
          "result_key",
          "state"
        ]
      },
      "CutoutRequest": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ra_deg": {
            "type": "number",
            "format": "double",
            "maximum": 359.999999,
            "minimum": 0
          },
          "dec_deg": {
            "type": "number",
            "format": "double",
            "maximum": 90,
            "minimum": -90
          },
          "size_deg": {
            "type": "number",
            "format": "double",
            "maximum": 1,
            "minimum": 1e-06
          }
        },
        "required": [
          "dec_deg",
          "product_id",
          "ra_deg",
          "size_deg"
        ]
      },
      "FitsMetadata": {
        "type": "object",
        "properties": {
          "cutout_id": {
            "type": "string"
          },
          "object_key": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "time_bounds_lower": {
            "type": "number",
            "format": "double"
          },
          "fits": {
            "type": "object",
            "additionalProperties": {}
          }
        },
        "required": [
          "cutout_id",
          "fits",
          "object_key",
          "source_url",
          "time_bounds_lower"
        ]
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sessionid"
      }
    }
  }
