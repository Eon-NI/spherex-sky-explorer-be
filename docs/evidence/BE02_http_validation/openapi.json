            "description": ""
          }
        }
      }
    },
    "/api/v1/cutouts/jobs/{job_id}/": {
      "get": {
        "operationId": "cutouts_jobs_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "tags": [
          "cutouts"
        ],
        "security": [
          {
            "cookieAuth": []
          },
          {
            "basicAuth": []
          },
          {}
        ],
        "responses": {
