            "cookieAuth": []
          },
          {
            "basicAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "content": {
              "application/fits": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            },
            "description": ""
          }
        }
      }
    },
    "/api/v1/cutouts/{cutout_id}/metadata/": {
      "get": {
        "operationId": "cutouts_metadata_retrieve",
        "parameters": [
          {
            "in": "path",
            "name": "cutout_id",
            "schema": {
              "type": "string"
            },
            "required": true
